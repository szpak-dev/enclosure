{% set exact_data = properties.copy() %}
{% if data.actions | default([]) %}
{% do exact_data.update({"actions": data.actions}) %}
{% endif %}
{% if data.links | default([]) %}
{% do exact_data.update({"links": data.links}) %}
{% endif %}
{% set exact_follow_ups = [] %}
{% if properties.has_more %}
{% do exact_follow_ups.append({"operation_id": "read_scaffolding_rendered_file", "arguments": {"scaffolding_id": properties.scaffolding_id, "parameters": invocation.parameters, "path": properties.path, "expected_revision": properties.revision, "offset": properties.next_offset, "limit": properties.limit}}) %}
{% endif %}
{
  "operation_id": {{ operation_id | tojson }},
  "status": "ok",
  "summary": "Bounded rendered scaffolding file content.",
  "data": {{ exact_data | tojson }},
  "follow_ups": {{ exact_follow_ups | tojson }}
}
