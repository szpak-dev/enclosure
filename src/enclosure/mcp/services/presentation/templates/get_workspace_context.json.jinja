{
  "is_error": {{ (properties.readiness != "ready") | tojson }},
  "structured_content": {
    "operation_id": "get_workspace_context",
    "status": {{ properties.readiness | tojson }},
    "project_id": {{ properties.project_id | tojson }},
    "root": {{ properties.root | tojson }},
    "authority": {{ properties.receipt.authority | tojson }},
    "bootstrap": {
      "uri": {{ bootstrap.uri | tojson }},
      "release": {{ bootstrap.release | tojson }},
      "revision": {{ bootstrap.revision | tojson }}
    },
    "items": [
      {% for item in properties.receipt["items"] %}{
        "record_id": {{ item.record_id | tojson }},
        "title": {{ item.title | tojson }},
        "requirement": {{ item.requirement | tojson }},
        "reason": {{ item.reason | tojson }},
        "explanation": {{ item.explanation | tojson }},
        "authority": {{ item.authority | tojson }},
        "revision": {{ item.revision | tojson }},
        "checks": {{ item.checks | tojson }},
        "follow_up": {
          "operation_id": "get_record",
          "arguments": {"record_id": {{ item.record_id | tojson }}}
        }
      }{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "required_checks": {{ properties.receipt.required_checks | tojson }},
    "budget": {{ properties.receipt.budget | tojson }},
    "coverage": {{ properties.receipt.coverage | tojson }},
    "omissions": {{ properties.receipt.omissions | tojson }},
    "diagnostics": {{ properties.receipt.diagnostics | tojson }},
    "stop_condition": {{ properties.receipt.stop_condition | tojson }}
  }
}
