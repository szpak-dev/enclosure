{% set guidance = [] %}
{% if properties.mandatory_guidance is defined or properties.optional_guidance is defined %}
{% for item in properties.mandatory_guidance | default([]) %}{% do guidance.append({"item": item, "kind": "mandatory"}) %}{% endfor %}
{% for item in properties.optional_guidance | default([]) %}{% do guidance.append({"item": item, "kind": "optional"}) %}{% endfor %}
{% else %}
{% for item in properties.guidance %}
{% set kind = "mandatory" if item.mandatory is defined and item.mandatory else "optional" if item.mandatory is defined else "selected" %}
{% do guidance.append({"item": item, "kind": kind}) %}
{% endfor %}
{% endif %}
{% set counts = namespace(checks=0) %}
{% for entry in guidance %}{% set counts.checks = counts.checks + (entry.item.checks | length) %}{% endfor %}
{
  "is_error": {{ ((properties.readiness | default("ready")) != "ready") | tojson }},
  "structured_content": {
    "operation_id": "get_workspace_context",
    "status": {{ properties.readiness | default("ready") | tojson }},
    "project_id": {{ properties.project_id | tojson }},
    "root": {{ properties.root | tojson }},
    "authority": {{ properties.authority | tojson }},
    "bootstrap": {
      "uri": {{ bootstrap.uri | tojson }},
      "release": {{ bootstrap.release | tojson }},
      "revision": {{ bootstrap.revision | tojson }}
    },
    "guidance": [
      {% for entry in guidance %}{
        "id": {{ entry.item.id | tojson }},
        "title": {{ entry.item.title | tojson }},
        "kind": {{ entry.kind | tojson }},
        "check_count": {{ entry.item.checks | length }}
      }{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "guidance_count": {{ guidance | length }},
    "check_count": {{ counts.checks }},
    "omissions": {{ properties.omissions | default([]) | tojson }},
    "diagnostics": {{ properties.diagnostics | default([]) | tojson }}
  }
}
