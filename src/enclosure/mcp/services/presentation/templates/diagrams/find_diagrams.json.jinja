{% set summary = "Diagram references." %}
{% from "shared/partials/envelope.json.jinja" import envelope with context %}
{% set follow_ups = [] %}
{% if data.has_more %}
{% do follow_ups.append({"operation_id": operation_id, "arguments": {"offset": data.next_offset, "limit": data.limit}}) %}
{% endif %}
{{ envelope(operation_id, "ok", summary, data, follow_ups) }}
