{
  "operation_id": {{ operation_id | tojson }},
  "status": "ok",
  "summary": "Record created with bounded resource manifests.",
  "data": {{ data | tojson }},
  "follow_ups": [
    {% for resource in data.resources %}
    {"operation_id": "read_record_resource", "arguments": {"record_id": {{ data.id | tojson }}, "path": {{ resource.path | tojson }}, "expected_revision": {{ resource.revision | tojson }}, "offset": 0, "limit": 512}}{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
