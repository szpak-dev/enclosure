# Compose reuses these credentials and overrides only the container-side
# address to resumed-db:5432. Host development continues through localhost:5432.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/modwire_records
SECRET_KEY=replace-with-a-local-secret

ENCLOSURE_MCP_PORT=8666
ENCLOSURE_PROJECTS_DIR=/Users/gorky/Projects
RECORDS_EMBEDDINGS_ENABLED=1
RECORDS_EMBEDDING_PROVIDER=deterministic
